{
  "name": "keeptrail",
  "version": "0.1.0",
  "private": true,
  "description": "A local discovery library that turns saved videos, links, and images into searchable notes and visual connections.",
  "license": "MIT",
  "engines": {
    "node": "22.23.2",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build:web && npm run build:server && npm run build:worker && npm run build:mcp",
    "build:web": "npm -w apps/web run build",
    "build:server": "npm -w apps/server run build",
    "build:worker": "npm -w apps/worker run build",
    "build:mcp": "npm -w apps/mcp run build",
    "start": "node scripts/start.mjs",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test:live": "node scripts/test-live.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "demo:seed": "node scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.16.5",
    "@types/jsdom": "21.1.7",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/sanitize-html": "2.16.0",
    "@types/yazl": "3.3.1",
    "eslint": "9.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "8.3.0",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mozilla/readability": "0.5.0",
    "@tanstack/react-query": "5.84.1",
    "@tanstack/react-virtual": "3.13.12",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.4",
    "lucide-react": "0.536.0",
    "marked": "18.0.12",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sanitize-html": "2.17.0",
    "sharp": "0.35.4",
    "yazl": "3.3.1",
    "zod": "4.6.2"
  }
}
